{
  "_说明": "这是配置模板。复制为 config.json 后填入你自己的值；config.json 已被 .gitignore 忽略，不会进仓库。",

  "api_base": "https://api.siliconflow.cn/v1",
  "api_key": "在这里填你的服务商 API Key",
  "model": "zai-org/GLM-5.3",
  "memory_dir": "在这里填记忆目录的绝对路径，例如 D:\\your-project\\brain\\data\\memory",
  "chat_mode": "api",
  "persona_file": "personas/linzhixia.json",

  "window": {
    "level": "bottom",
    "sink_on_fullscreen": false
  },

  "brain_token": "云端 /api/* 的访问码，客户端（App / 桌宠）用同一个值，随便编一个长随机串",
  "bind_host": "部署到云服务器时填 0.0.0.0 才能被手机连到；本机跑就删掉这行（默认只绑 127.0.0.1）",

  "watchdog": {
    "keep_pet": true
  },

  "vision": {
    "enabled": true,
    "model": "Qwen/Qwen3-VL-30B-A3B-Instruct",
    "max_side": 640,
    "max_tokens": 200
  },

  "time_awareness": {
    "enabled": true,
    "absence_minutes": 30
  },

  "proactive": {
    "enabled": true,
    "max_per_day": 99,
    "interval_sec": 2400,
    "quiet_start": "24:00",
    "quiet_end": "24:01",
    "on_activity_change": true,
    "on_game_start": true,
    "on_startup": true
  },

  "watcher": {
    "enabled": true,
    "probe_sec": 5,
    "cooldown": 600,
    "game_pause": true,
    "title_proactive_interval": 2400
  },

  "brain_remote": "http://127.0.0.1:18787"
}
